{
  "name": "@cpi-ai/compiler",
  "version": "1.0.0",
  "description": "TypeScript compiler for SAP Cloud Integration (CPI) Integration Flows - AI-powered npm package",
  "main": "packages/compiler/dist/index.js",
  "types": "packages/compiler/dist/index.d.ts",
  "files": [
    "packages/compiler/dist",
    "packages/compiler/README.md",
    "packages/compiler/LICENSE"
  ],
  "scripts": {
    "build": "cd packages/compiler && npm run build",
    "prepare": "cd packages/compiler && npm install && npm run build",
    "helloworld": "ts-node examples/helloworld.ts",
    "groovy": "ts-node examples/groovy-script.ts",
    "router": "ts-node examples/router.ts",
    "datastore": "ts-node examples/datastore.ts",
    "multicast": "ts-node examples/multicast.ts",
    "splitter": "ts-node examples/splitter.ts",
    "gather": "ts-node examples/gather.ts",
    "mapping": "ts-node examples/message-mapping.ts",
    "minimal": "ts-node examples/minimal-demo.ts",
    "ai-demo": "ts-node examples/ai-generation.ts",
    "e2e-demo": "ts-node examples/end-to-end.ts",
    "consumer": "ts-node examples/consumer-example.ts",
    "test-compiler": "ts-node test-compiler-package.ts",
    "all-components": "ts-node all-components-demo.ts",
    "comprehensive": "ts-node comprehensive-flow-demo.ts",
    "order-demo": "ts-node examples/order-processing-package.ts",
    "demo": "ts-node demo/server.ts",
    "clean": "rimraf dist",
    "prepublish": "npm run build"
  },
  "keywords": [
    "sap",
    "cpi",
    "integration",
    "iflow",
    "bpmn",
    "integration-suite",
    "cloud-integration",
    "compiler",
    "code-generation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/SahasranamanAdesso/cpi-ai_compiler.git"
  },
  "bugs": {
    "url": "https://github.com/SahasranamanAdesso/cpi-ai_compiler/issues"
  },
  "author": {
    "name": "Sahasranaman",
    "url": "https://github.com/SahasranamanAdesso"
  },
  "license": "MIT",
  "dependencies": {
    "archiver": "^8.0.0",
    "xmlbuilder2": "^3.1.1",
    "dotenv": "^16.6.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "rimraf": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
